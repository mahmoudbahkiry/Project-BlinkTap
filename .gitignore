# === Mac system files ===
.DS_Store
*.icloud

# === Unity generated folders (inside UnityImplementations) ===
UnityImplementations/Library/
UnityImplementations/Logs/
UnityImplementations/Temp/
UnityImplementations/Obj/
UnityImplementations/Build/
UnityImplementations/Builds/
UnityImplementations/UserSettings/
BlinkTap-Backend/firebaseKey.json

# === Build artifacts ===
*.apk
*.unitypackage
*.aab
*.exe
*.dll
*.so
*.dylib
*.app
*.xcodeproj
*.xcworkspace

# === Visual Studio, VSCode, Rider ===
.vscode/
.idea/
*.sln
*.csproj
*.suo
*.user
*.userprefs
*.unityproj
*.booproj
*.svd
*.tmp
*.log

# === Crashlytics / Analytics files ===
UnityImplementations/crashlytics-build.properties

# === Backup / temporary files ===
*.bak
*.old
*.orig

# === Uploaded builds (optional) ===
UnityImplementations/[Uu]ploadedBuilds/

# === Addressables (optional, if you use them) ===
UnityImplementations/Assets/AddressableAssetsData/**/*.bin
UnityImplementations/Assets/AddressableAssetsData/**/*.catalog

# === Important: Don't ignore your real work ===
!UnityImplementations/Assets/**
!UnityImplementations/ProjectSettings/**
!UnityImplementations/Packages/manifest.json
!UnityImplementations/Packages/packages-lock.json
